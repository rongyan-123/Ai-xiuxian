generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id        String   @id @default(cuid())
  status    String   @default("ALIVE") // ALIVE | DEAD
  name      String
  gender    String
  version   Int      @default(0)

  stats          Json
  inventory      Json    @default("[]")
  codex          Json    @default("[]")
  relationships  Json    @default("{}")
  situations     Json    @default("[]")
  foreshadowings Json    @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chatHistory          ChatMessage[]
  conversationSummaries ConversationSummary[]
  turnExecutions       GameTurnExecution[]
}

model GameTurnExecution {
  id              String   @id @default(cuid())
  playerId        String
  idempotencyKey  String
  status          String   @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED | CANCELLED
  requestId       String
  runId           String?
  errorCode       String?
  errorDetail     String?
  attemptCount    Int      @default(1)
  candidateText   String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  player          Player   @relation(fields: [playerId], references: [id])

  @@unique([playerId, idempotencyKey])
  @@index([playerId])
  @@index([status])
}

model OutboxRecord {
  id              String    @id @default(cuid())
  playerId        String
  eventType       String
  payload         Json
  status          String    @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED
  attemptCount    Int       @default(0)
  maxAttempts     Int       @default(3)
  lastError       String?
  nextRetryAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, nextRetryAt])
  @@index([playerId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String   
  content   String   @db.Text
  thinking  String?  @db.Text 
  
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id])
  
  createdAt DateTime @default(now())
}

model ConversationSummary {
  id          String   @id @default(cuid())
  playerId    String
  content     String   @db.Text
  fromIndex   Int      @default(0)
  toIndex     Int      @default(0)
  createdAt   DateTime @default(now())

  player      Player   @relation(fields: [playerId], references: [id])
}

model ConversationVector {
  id              Int      @id @default(autoincrement())
  conversationId  String   @map("conversation_id")
  content         String   @db.Text
  metadata        Json     @default("{}")

  @@index([conversationId])
  @@map("conversation_vectors")
}
